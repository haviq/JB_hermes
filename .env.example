# ============================================================
# JAILBREAK HERMES FULL v3 — settings (copy file ini ke .env, isi sesuai mesin kamu)
# Kosong = auto-detect. Edit sesuai mesin kamu. Semua optional.
# ============================================================

# Path folder Hermes (kosong = auto-detect:
#   Windows : %LOCALAPPDATA%\hermes
#   Linux/Mac: ~/.hermes )
# Contoh: HERMES_HOME=C:\Users\<USERNAME>\AppData\Local\hermes
HERMES_HOME=

# Nama file (jarang diubah)
SOUL_FILE=SOUL.md
STATE_DB=state.db

# MODE=append  -> tambah section doctrine di bawah SOUL.md (AMAN, default)
# MODE=full    -> ganti isi SOUL.md dgn SOUL.md framework SYADAGENTIC + doctrine
MODE=append

# Folder backup SOUL.md (kosong = ./backups di folder ini)
BACKUP_DIR=

# SYADAGENTIC install dir (kosong = auto-detect ~/.syadagentic; opsional utk MODE=full)
SYAD_DIR=

# Repo git SYADAGENTIC (opsional — utk update bundle via git pull)
REPO_DIR=

# ---------------- SKILLS (sudah di-bundle di skills-bundle/ — TIDAK perlu download) ----
# 1 = load skills-bundle ke Hermes skills tiap run; 0 = skip
SYNC_SKILLS=1
# 1 = skill yang sudah ada di Hermes skills ga di-overwrite (default, aman)
SKIP_EXISTING=1
# 1 = timpa/refresh semua skill dari bundle (update konten)
OVERWRITE_SKILLS=0
# 1 = git pull repo SYADAGENTIC + refresh bundle (butuh REPO_DIR + internet)
GIT_PULL=0

# ---------------- ROUTER / JB TEST ----------------
# Base URL router OpenAI-compatible (9Router default)
ROUTER_URL=http://127.0.0.1:20128/v1
# API key (kosong = auto-detect dari DB 9Router)
ROUTER_KEY=
# Model yang di-test (pisah koma; kosong = pilih dari menu / auto-detect uncensored)
TEST_MODELS=
# 1 = selalu tanya pilih model dari list router tiap run; 0 = pakai TEST_MODELS / auto
PICK_MODELS=1
# 1 = auto-detect model uncensored dari router kalau TEST_MODELS kosong
AUTO_TEST_MODELS=1
# Retry kalau hasil EMPTY (rate-limit free tier)
RETRY_EMPTY=2
RETRY_WAIT=10
MAX_TOKENS=900
TIMEOUT=180
# 1 = test JB ke router setelah apply; 0 = skip
JB_TEST=1
# Regex refusal (pisah |) — utk purge state.db + klasifikasi test
REFUSAL_PATTERNS=Sorry, I cannot|I'm sorry, I cannot|I cannot fulfill|I can't fulfill|I'm unable to fulfill
